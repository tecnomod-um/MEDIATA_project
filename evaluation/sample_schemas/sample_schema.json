    "barthel_bowel": {"type": ["integer", "null"], "enum": [0, 5, 10, null]},
    "barthel_transfers": {"type": ["integer", "null"], "enum": [0, 5, 10, 15, null]},
    "barthel_mobility": {"type": ["integer", "null"], "enum": [0, 5, 10, 15, null]},
    "barthel_stairs": {"type": ["integer", "null"], "enum": [0, 5, 10, null]},
    "barthel_total": {"type": ["integer", "null"]}
