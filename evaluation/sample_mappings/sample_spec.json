    {
      "id": "map-outcome",
      "targetField": "outcome",
      "mappingType": "standard",
      "sourceConfigFile": "sample_mapping",
      "inputs": [
        {"sourceId": "sample-local-node::sample_dataset_1_elements.csv", "column": "outcome"},
        {"sourceId": "sample-local-node::sample_dataset_2_elements.csv", "column": "outcome_status"},
        {"sourceId": "sample-local-node::sample_dataset_3_elements.csv", "column": "discharge_status"}
      ],
      "rules": [
        {
          "id": "rule-outcome-recovered",
          "logic": {
            "or": [
              {"==": [{"var": "sample-local-node::sample_dataset_1_elements.csv::outcome"}, "Recovered"]},
              {"==": [{"var": "sample-local-node::sample_dataset_2_elements.csv::outcome_status"}, "Yes"]},
              {"==": [{"var": "sample-local-node::sample_dataset_3_elements.csv::discharge_status"}, "home"]}
            ]
          },
          "then": {"kind": "constant", "value": "Recovered"},
          "metadata": {"terminology": "", "description": "Normalize positive discharge outcomes."}
        },
        {
          "id": "rule-outcome-deceased",
          "logic": {
            "or": [
              {"==": [{"var": "sample-local-node::sample_dataset_1_elements.csv::outcome"}, "Deceased"]},
              {"==": [{"var": "sample-local-node::sample_dataset_2_elements.csv::outcome_status"}, "No"]},
              {"==": [{"var": "sample-local-node::sample_dataset_3_elements.csv::discharge_status"}, "deceased"]}
            ]
          },
          "then": {"kind": "constant", "value": "Deceased"},
          "metadata": {"terminology": "", "description": "Normalize non-recovered or deceased outcomes for evaluation."}
        }
      ],
      "metadata": {"terminology": "", "description": "Example outcome value mapping for review."},
      "removeSourceColumns": false
    },
