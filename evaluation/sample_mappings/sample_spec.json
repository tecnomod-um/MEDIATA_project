  "mappings": [
    {
      "id": "map-sex",
      "targetField": "sex",
      "mappingType": "standard",
      "sourceConfigFile": "sample_mapping",
      "inputs": [
        {"sourceId": "sample-local-node::sample_dataset_1_elements.csv", "column": "sex"},
        {"sourceId": "sample-local-node::sample_dataset_2_elements.csv", "column": "gender"},
        {"sourceId": "sample-local-node::sample_dataset_3_elements.csv", "column": "gender_code"}
      ],
      "rules": [
        {
          "id": "rule-sex-male",
          "logic": {
            "or": [
              {"==": [{"var": "sample-local-node::sample_dataset_1_elements.csv::sex"}, "M"]},
              {"==": [{"var": "sample-local-node::sample_dataset_2_elements.csv::gender"}, "Male"]},
              {"==": [{"var": "sample-local-node::sample_dataset_3_elements.csv::gender_code"}, "1"]}
            ]
          },
          "then": {"kind": "constant", "value": "Male"},
          "metadata": {"terminology": "", "description": "Normalize male encodings."}
        },
        {
          "id": "rule-sex-female",
          "logic": {
            "or": [
              {"==": [{"var": "sample-local-node::sample_dataset_1_elements.csv::sex"}, "F"]},
              {"==": [{"var": "sample-local-node::sample_dataset_2_elements.csv::gender"}, "Female"]},
              {"==": [{"var": "sample-local-node::sample_dataset_3_elements.csv::gender_code"}, "0"]}
            ]
          },
          "then": {"kind": "constant", "value": "Female"},
          "metadata": {"terminology": "", "description": "Normalize female encodings."}
        }
      ],
      "metadata": {"terminology": "", "description": "Example categorical value normalization."},
      "removeSourceColumns": false
    },
