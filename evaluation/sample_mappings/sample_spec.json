        {"sourceId": "sample-local-node::sample_dataset_3_elements.csv", "column": "diagnosis"}
      ],
      "rules": [
        {
          "id": "rule-diagnosis-code-1",
          "logic": {"==": [{"var": "sample-local-node::sample_dataset_1_elements.csv::diagnosis_code"}, "I10"]},
          "then": {"kind": "constant", "value": "I10"},
          "metadata": {"terminology": "", "description": "Example diagnosis code."}
        },
        {
          "id": "rule-diagnosis-code-2",
          "logic": {"==": [{"var": "sample-local-node::sample_dataset_3_elements.csv::diagnosis"}, "I10"]},
          "then": {"kind": "constant", "value": "I10"},
