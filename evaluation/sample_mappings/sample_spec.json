          "metadata": {"terminology": "", "description": "Copy ISO admission date."}
        },
        {
          "id": "rule-admission-date-2",
          "logic": {"is_date": [{"var": "sample-local-node::sample_dataset_2_elements.csv::admit_dt"}]},
          "then": {"kind": "source-value", "sourceId": "sample-local-node::sample_dataset_2_elements.csv", "column": "admit_dt"},
          "metadata": {"terminology": "", "description": "Copy day/month/year admission date."}
        },
        {
          "id": "rule-admission-date-3",
          "logic": {"is_date": [{"var": "sample-local-node::sample_dataset_3_elements.csv::visit_date"}]},
          "then": {"kind": "source-value", "sourceId": "sample-local-node::sample_dataset_3_elements.csv", "column": "visit_date"},
          "metadata": {"terminology": "", "description": "Copy visit date."}
        }
