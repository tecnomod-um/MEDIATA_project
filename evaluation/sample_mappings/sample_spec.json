                  },
                  "Female"
                ]
              },
              {
                "==": [
                  {
                    "var": "sample-local-node::sample_dataset_3_elements.csv::sex_code"
                  },
                  "2"
                ]
              }
            ]
          },
          "then": {
            "kind": "constant",
            "value": "Female"
          },
          "metadata": {
            "terminology": "",
            "description": "Normalize female values."
          }
        },
        {
          "id": "rule-sex-unknown",
          "logic": {
            "or": [
              {
                "==": [
                  {
                    "var": "sample-local-node::sample_dataset_1_elements.csv::sex"
                  },
                  "U"
                ]
              },
              {
                "==": [
                  {
                    "var": "sample-local-node::sample_dataset_2_elements.csv::patient_sex"
                  },
                  "Unknown"
                ]
              },
              {
                "==": [
                  {
                    "var": "sample-local-node::sample_dataset_3_elements.csv::sex_code"
                  },
                  "9"
                ]
              }
            ]
          },
          "then": {
